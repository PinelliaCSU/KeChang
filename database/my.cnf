# MySQL 8.0 性能优化配置
[mysqld]

# === InnoDB 缓冲池（核心性能参数）===
# 生产环境建议设为系统内存的 50-70%
innodb_buffer_pool_size = 512M
# 缓冲池实例数（SSD 建议 1，多磁盘建议 4-8）
innodb_buffer_pool_instances = 4

# === 日志配置 ===
# 重做日志大小（过大恢复慢，过小写入频繁 checkpoint）
innodb_log_file_size = 256M
# 日志刷盘策略：1=每次提交刷盘(安全慢), 2=每秒刷盘(性能好，丢失最多1秒数据)
innodb_flush_log_at_trx_commit = 2
# 日志缓冲区
innodb_log_buffer_size = 16M

# === 连接与线程 ===
max_connections = 200
# 线程缓存，避免频繁创建销毁
thread_cache_size = 16

# === 表缓存 ===
# 打开表的缓存数
table_open_cache = 2000
# 表定义缓存
table_definition_cache = 2000

# === 排序与临时表 ===
# 排序缓冲区（按需分配，不宜过大）
sort_buffer_size = 2M
# JOIN 缓冲区
join_buffer_size = 2M
# 临时表最大大小（超过则写磁盘）
tmp_table_size = 64M
max_heap_table_size = 64M

# === 字符集 ===
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# === 慢查询日志（排查问题时开启）===
slow_query_log = 0
long_query_time = 2

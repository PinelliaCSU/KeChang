# ============================================
# 课畅前端 - 环境变量配置示例
# ============================================
# 复制此文件为 .env 或 .env.development 并根据需要修改
# 注意: .env 和 .env.local 会被 .gitignore 忽略，不会提交到仓库
# ============================================

# 后端 API 基础地址（开发时 Vite 会代理请求到此地址）
VITE_API_BASE_URL=http://localhost:8080

# 应用标题
VITE_APP_TITLE=课畅
